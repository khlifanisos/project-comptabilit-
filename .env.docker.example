# Copy to .env.docker and fill in. Generate APP_KEY with:
#   docker compose run --rm backend php artisan key:generate --show
APP_NAME="Intelligence Comptabilite"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080
SANCTUM_STATEFUL_DOMAINS=localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=comptabilite_db
DB_USERNAME=comptabilite
DB_PASSWORD=change-me

MYSQL_DATABASE=comptabilite_db
MYSQL_USER=comptabilite
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Intelligence Comptabilite"
BREVO_API_KEY=
GEMINI_API_KEY=

SMS_COUNTRY_CODE=+216
